<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme used after splash — no title bar, dark status/nav -->
    <style name="Theme.ZENINNative" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- Splash screen theme — shown during launch, then transitions to app theme -->
    <style name="Theme.ZENINNative.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ZENINNative</item>
    </style>
</resources>
